rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Global Primitives & Identity Helpers
    // ------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'domitory@pcccr.ac.th';
    }

    function isAdmin() {
      return isEmailVerified() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleLevel == 1
        )
      );
    }

    // ------------------------------------------------------------------
    // Validation Blueprints
    // ------------------------------------------------------------------
    function isValidDormitory(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.keys().hasOnly([
          'id', 'name', 'type', 'gender', 'teacherName',
          'teacherPhone', 'capacity', 'teachers', 'assignedTeacherId'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('type' in data) || data.type in ['male', 'female', 'mixed']) &&
        (!('gender' in data) || data.gender in ['male', 'female', 'mixed']) &&
        (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 160)) &&
        (!('teacherPhone' in data) || (data.teacherPhone is string && data.teacherPhone.size() <= 40)) &&
        (!('capacity' in data) || (data.capacity is number && data.capacity >= 0 && data.capacity <= 5000)) &&
        (!('teachers' in data) || (data.teachers is list && data.teachers.size() <= 30 && (data.teachers.size() == 0 || data.teachers[0] is map))) &&
        (!('assignedTeacherId' in data) || (data.assignedTeacherId is string && data.assignedTeacherId.size() <= 128));
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'studentId', 'firstName', 'lastName', 'dormId']) &&
        data.keys().hasOnly([
          'id', 'studentId', 'no', 'title', 'firstName', 'lastName',
          'nickname', 'grade', 'room', 'dormId', 'dormRoom', 'dormBed', 'bed', 'gender'
        ]) &&
        isValidId(data.id) &&
        data.studentId is string && data.studentId.size() == 5 && data.studentId.matches('^[0-9]{5}$') &&
        data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100 &&
        data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100 &&
        isValidId(data.dormId) &&
        (!('no' in data) || (data.no is number && data.no >= 0 && data.no <= 2000)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 40)) &&
        (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 60)) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 20)) &&
        (!('room' in data) || (data.room is number && data.room >= 0 && data.room <= 100)) &&
        (!('dormRoom' in data) || (data.dormRoom is string && data.dormRoom.size() <= 40)) &&
        (!('dormBed' in data) || ((data.dormBed is string && data.dormBed.size() <= 20) || data.dormBed is number)) &&
        (!('bed' in data) || ((data.bed is string && data.bed.size() <= 20) || data.bed is number)) &&
        (!('gender' in data) || data.gender in ['male', 'female']);
    }

    function isValidUserProfile(data) {
      return !('password' in data) &&
        data.keys().hasAll(['id', 'name', 'role']) &&
        data.keys().hasOnly([
          'id', 'name', 'role', 'roleLevel', 'roleCategory', 'roleCategoryName',
          'roleLabel', 'phone', 'gender', 'dormId', 'dormPosition', 'allowedDormIds',
          'avatarUrl', 'passwordHash', 'hasPassword'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.role in ['ADMIN_OFFICER', 'HEAD_TEACHER', 'DORM_TEACHER', 'DEPUTY_DIRECTOR', 'SYSTEM_ADMIN', 'GUEST'] &&
        (!('roleLevel' in data) || data.roleLevel in [1, 2, 3, 4]) &&
        (!('roleCategory' in data) || data.roleCategory in ['ADMIN', 'STAFF', 'DORM_TEACHER', 'GUEST']) &&
        (!('roleCategoryName' in data) || (data.roleCategoryName is string && data.roleCategoryName.size() <= 80)) &&
        (!('roleLabel' in data) || (data.roleLabel is string && data.roleLabel.size() <= 160)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('gender' in data) || data.gender in ['male', 'female']) &&
        (!('dormId' in data) || (data.dormId is string && data.dormId.size() <= 128)) &&
        (!('dormPosition' in data) || (data.dormPosition is string && data.dormPosition.size() <= 80)) &&
        (!('allowedDormIds' in data) || (data.allowedDormIds is list && data.allowedDormIds.size() <= 20 && (data.allowedDormIds.size() == 0 || data.allowedDormIds[0] is string))) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 65536)) &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 512)) &&
        (!('hasPassword' in data) || data.hasPassword is bool);
    }

    function isValidUserDirectory(data) {
      return !('password' in data) &&
        !('passwordHash' in data) &&
        !('phone' in data) &&
        !('email' in data) &&
        data.keys().hasAll(['id', 'name', 'role', 'hasPassword']) &&
        data.keys().hasOnly([
          'id', 'name', 'role', 'roleLevel', 'roleCategory', 'roleCategoryName',
          'roleLabel', 'gender', 'dormId', 'dormPosition', 'allowedDormIds',
          'avatarUrl', 'hasPassword'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.role in ['ADMIN_OFFICER', 'HEAD_TEACHER', 'DORM_TEACHER', 'DEPUTY_DIRECTOR', 'SYSTEM_ADMIN', 'GUEST'] &&
        data.hasPassword is bool &&
        (!('roleLevel' in data) || data.roleLevel in [1, 2, 3, 4]) &&
        (!('roleCategory' in data) || data.roleCategory in ['ADMIN', 'STAFF', 'DORM_TEACHER', 'GUEST']) &&
        (!('roleCategoryName' in data) || (data.roleCategoryName is string && data.roleCategoryName.size() <= 80)) &&
        (!('roleLabel' in data) || (data.roleLabel is string && data.roleLabel.size() <= 160)) &&
        (!('gender' in data) || data.gender in ['male', 'female']) &&
        (!('dormId' in data) || (data.dormId is string && data.dormId.size() <= 128)) &&
        (!('dormPosition' in data) || (data.dormPosition is string && data.dormPosition.size() <= 80)) &&
        (!('allowedDormIds' in data) || (data.allowedDormIds is list && data.allowedDormIds.size() <= 20 && (data.allowedDormIds.size() == 0 || data.allowedDormIds[0] is string))) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 65536));
    }

    function isValidUserAuth(data) {
      return !('password' in data) &&
        !('phone' in data) &&
        !('email' in data) &&
        data.keys().hasAll(['id', 'hasPassword']) &&
        data.keys().hasOnly(['id', 'hasPassword', 'passwordHash', 'updatedAt']) &&
        isValidId(data.id) &&
        data.hasPassword is bool &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() > 0 && data.passwordHash.size() <= 512 && data.passwordHash.matches('^pbkdf2_sha256\\$.+$'))) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidNotice(data) {
      return data.keys().hasAll(['id', 'title', 'date']) &&
        data.keys().hasOnly(['id', 'date', 'title', 'topics', 'createdBy', 'createdAt']) &&
        isValidId(data.id) &&
        isValidDateStr(data.date) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('topics' in data) || (data.topics is list && data.topics.size() <= 30 && (data.topics.size() == 0 || data.topics[0] is string))) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidDailyAttendance(data) {
      return data.keys().hasAll(['id', 'date', 'dormId']) &&
        data.keys().hasOnly([
          'id', 'date', 'dormId', 'isHomeBreak', 'status',
          'checkedAt', 'checkedBy', 'teacherOrientationNotes', 'records'
        ]) &&
        isValidId(data.id) &&
        isValidDateStr(data.date) &&
        isValidId(data.dormId) &&
        (!('isHomeBreak' in data) || data.isHomeBreak is bool) &&
        (!('status' in data) || data.status in ['CHECKED', 'HOME_BREAK', 'SEMESTER_BREAK', 'PENDING']) &&
        (!('checkedAt' in data) || (data.checkedAt is string && data.checkedAt.size() <= 64)) &&
        (!('checkedBy' in data) || (data.checkedBy is string && data.checkedBy.size() <= 120)) &&
        (!('teacherOrientationNotes' in data) || (data.teacherOrientationNotes is list && data.teacherOrientationNotes.size() <= 30 && (data.teacherOrientationNotes.size() == 0 || data.teacherOrientationNotes[0] is string))) &&
        (!('records' in data) || (data.records is list && data.records.size() <= 500 && (data.records.size() == 0 || data.records[0] is map)));
    }

    function isValidSystemSettings(data) {
      return data.keys().hasOnly([
          'schoolNameTh', 'schoolNameEn', 'schoolAcronymTh', 'schoolAcronymEn',
          'schoolLogoUrl', 'systemNameTh', 'systemNameEn', 'systemTitleTh', 'systemTitleEn',
          'systemIcon', 'lastUpdatedDate', 'maintenanceTitle', 'maintenanceMessage',
          'showMaintenancePopup', 'showMaintenanceBox', 'isAttendancePaused', 'pausedDormIds',
          'attendancePauseReason', 'attendancePausedAt', 'attendancePausedBy',
          'navigationPermissions', 'guestRequiresLogin'
        ]) &&
        (!('schoolNameTh' in data) || (data.schoolNameTh is string && data.schoolNameTh.size() <= 200)) &&
        (!('schoolNameEn' in data) || (data.schoolNameEn is string && data.schoolNameEn.size() <= 200)) &&
        (!('schoolAcronymTh' in data) || (data.schoolAcronymTh is string && data.schoolAcronymTh.size() <= 40)) &&
        (!('schoolAcronymEn' in data) || (data.schoolAcronymEn is string && data.schoolAcronymEn.size() <= 40)) &&
        (!('schoolLogoUrl' in data) || (data.schoolLogoUrl is string && data.schoolLogoUrl.size() <= 65536)) &&
        (!('systemNameTh' in data) || (data.systemNameTh is string && data.systemNameTh.size() <= 200)) &&
        (!('systemNameEn' in data) || (data.systemNameEn is string && data.systemNameEn.size() <= 200)) &&
        (!('systemTitleTh' in data) || (data.systemTitleTh is string && data.systemTitleTh.size() <= 200)) &&
        (!('systemTitleEn' in data) || (data.systemTitleEn is string && data.systemTitleEn.size() <= 200)) &&
        (!('systemIcon' in data) || (data.systemIcon is string && data.systemIcon.size() <= 40)) &&
        (!('lastUpdatedDate' in data) || (data.lastUpdatedDate is string && data.lastUpdatedDate.size() <= 80)) &&
        (!('maintenanceTitle' in data) || (data.maintenanceTitle is string && data.maintenanceTitle.size() <= 200)) &&
        (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 1000)) &&
        (!('showMaintenancePopup' in data) || data.showMaintenancePopup is bool) &&
        (!('showMaintenanceBox' in data) || data.showMaintenanceBox is bool) &&
        (!('isAttendancePaused' in data) || data.isAttendancePaused is bool) &&
        (!('pausedDormIds' in data) || (data.pausedDormIds is list && data.pausedDormIds.size() <= 50 && (data.pausedDormIds.size() == 0 || data.pausedDormIds[0] is string))) &&
        (!('attendancePauseReason' in data) || (data.attendancePauseReason is string && data.attendancePauseReason.size() <= 300)) &&
        (!('attendancePausedAt' in data) || (data.attendancePausedAt is string && data.attendancePausedAt.size() <= 64)) &&
        (!('attendancePausedBy' in data) || (data.attendancePausedBy is string && data.attendancePausedBy.size() <= 120)) &&
        (!('navigationPermissions' in data) || data.navigationPermissions is map) &&
        (!('guestRequiresLogin' in data) || data.guestRequiresLogin is bool);
    }

    function isValidSystemStatus(data) {
      return data.keys().hasOnly(['lastSavedAt', 'status']) &&
        (!('lastSavedAt' in data) || (data.lastSavedAt is string && data.lastSavedAt.size() <= 64)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 40));
    }

    function isValidProfileAvatar(data) {
      return data.keys().hasAll(['id', 'imageUrl']) &&
        data.keys().hasOnly(['id', 'imageUrl', 'label', 'uploadedBy', 'ownerUid', 'uploadedAt']) &&
        isValidId(data.id) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 65536 &&
        (!('label' in data) || (data.label is string && data.label.size() <= 120)) &&
        (!('uploadedBy' in data) || (data.uploadedBy is string && data.uploadedBy.size() <= 120)) &&
        (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
        (!('uploadedAt' in data) || (data.uploadedAt is string && data.uploadedAt.size() <= 64));
    }

    // ------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && ((isEmailVerified() && isOwner(userId)) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isEmailVerified() &&
        isValidUserProfile(incoming()) &&
        (
          isAdmin() ||
          (isOwner(userId) && incoming().role == 'GUEST' && incoming().roleLevel == 4 && incoming().roleCategory == 'GUEST')
        );
      allow update: if isValidId(userId) &&
        isEmailVerified() &&
        isValidUserProfile(incoming()) &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().id == existing().id &&
            incoming().role == existing().role &&
            incoming().roleLevel == existing().roleLevel &&
            incoming().roleCategory == existing().roleCategory &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'gender', 'avatarUrl', 'passwordHash', 'hasPassword'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /user_directory/{userId} {
      allow get: if isValidId(userId);
      allow list: if request.time != null;
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        isValidUserDirectory(incoming());
      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isValidUserDirectory(incoming()) &&
        (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(userId) && isSignedIn();
    }

    match /user_auth/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        isValidUserAuth(incoming());
      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isValidUserAuth(incoming()) &&
        (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(userId) && isSignedIn();
    }

    match /dorms/{dormId} {
      allow get: if isValidId(dormId);
      allow list: if request.time != null;
      allow create: if isValidId(dormId) && isSignedIn() && isValidDormitory(incoming());
      allow update: if isValidId(dormId) && isSignedIn() && isValidDormitory(incoming()) && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(dormId) && isSignedIn();
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId);
      allow list: if request.time != null;
      allow create: if isValidId(studentId) && isSignedIn() && isValidStudent(incoming()) &&
        exists(/databases/$(database)/documents/dorms/$(incoming().dormId));
      allow update: if isValidId(studentId) && isSignedIn() && isValidStudent(incoming()) && (!('id' in existing()) || incoming().id == existing().id) &&
        exists(/databases/$(database)/documents/dorms/$(incoming().dormId));
      allow delete: if isValidId(studentId) && isSignedIn();
    }

    match /notices/{noticeId} {
      allow get: if isValidId(noticeId);
      allow list: if request.time != null;
      allow create: if isValidId(noticeId) && isSignedIn() && isValidNotice(incoming());
      allow update: if isValidId(noticeId) && isSignedIn() && isValidNotice(incoming()) && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(noticeId) && isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow get: if isValidId(attendanceId);
      allow list: if request.time != null;
      allow create: if isValidId(attendanceId) &&
        isSignedIn() &&
        isValidDailyAttendance(incoming()) &&
        exists(/databases/$(database)/documents/dorms/$(incoming().dormId));
      allow update: if isValidId(attendanceId) &&
        isSignedIn() &&
        isValidDailyAttendance(incoming()) &&
        (!('id' in existing()) || incoming().id == existing().id) &&
        (!('date' in existing()) || incoming().date == existing().date) &&
        (!('dormId' in existing()) || incoming().dormId == existing().dormId) &&
        exists(/databases/$(database)/documents/dorms/$(incoming().dormId));
      allow delete: if isValidId(attendanceId) && isSignedIn();
    }

    match /system_settings/{configId} {
      allow get: if isValidId(configId) && configId == 'config';
      allow list: if false;
      allow create, update: if isValidId(configId) && configId == 'config' && isSignedIn() && isValidSystemSettings(incoming());
      allow delete: if false;
    }

    match /_system_status/{statusId} {
      allow get: if isValidId(statusId) && statusId == 'saved';
      allow list: if false;
      allow create, update: if isValidId(statusId) && statusId == 'saved' && isSignedIn() && isValidSystemStatus(incoming());
      allow delete: if false;
    }

    match /profile_avatars/{avatarId} {
      allow get: if isValidId(avatarId);
      allow list: if request.time != null;
      allow create: if isValidId(avatarId) &&
        isSignedIn() &&
        isValidProfileAvatar(incoming()) &&
        (!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid);
      allow update: if isValidId(avatarId) &&
        isSignedIn() &&
        isValidProfileAvatar(incoming()) &&
        (!('id' in existing()) || incoming().id == existing().id) &&
        (!('ownerUid' in existing()) || !('ownerUid' in incoming()) || incoming().ownerUid == existing().ownerUid);
      allow delete: if isValidId(avatarId) && isSignedIn();
    }
  }
}
